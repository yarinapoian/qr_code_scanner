<?xml version="1.0" encoding="UTF-8"?>
<!-- Mutation testing of the decoding core (docs/testing.md, quality gates).
     Run: dart run mutation_test mutation_test.xml --exclude-strings -f md
     Commands run in order per mutant; the first one that fails kills it and
     the rest are skipped. Fast unit tests go first; the decoder property
     test (~30 s) only runs for mutants the unit tests missed. It is needed
     because version_info, mask, data_blocks, codeword_placement and
     matrix_decoder have no unit tests of their own since D7. -->
<mutations version="1.0">
  <files>
    <file>lib/src/common/gf256.dart</file>
    <file>lib/src/decode/reed_solomon.dart</file>
    <file>lib/src/decode/format_info.dart</file>
    <file>lib/src/decode/version_info.dart</file>
    <file>lib/src/decode/mask.dart</file>
    <file>lib/src/decode/data_blocks.dart</file>
    <file>lib/src/decode/codeword_placement.dart</file>
    <file>lib/src/decode/bitstream.dart</file>
    <file>lib/src/decode/matrix_decoder.dart</file>
  </files>
  <exclude>
    <!-- comments and documentation -->
    <token begin="//" end="\n"/>
    <token begin="/*" end="*/"/>
    <!-- imports; string literals are skipped with exclude-strings -->
    <token begin="import" end=";"/>
    <!-- guard against mutants that loop forever -->
    <regex pattern="(while|for)\s*\(.*\)"/>
  </exclude>
  <commands>
    <command group="unit" expected-return="0" working-directory="." timeout="120">dart test test/decode test/common -t unit --reporter silent</command>
    <command group="property" expected-return="0" working-directory="." timeout="240">dart test test/decode/matrix_decoder_property_test.dart --reporter silent</command>
  </commands>
</mutations>
